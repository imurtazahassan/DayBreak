# DAYBREAK Environment Variables
# Copy to .env.local for local development

# Optional: Supabase configuration (if not provided, DAYBREAK automatically falls back to local JSON persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google AI Studio Gemini API Key (for 'why this matters' enrichments)
GEMINI_API_KEY=

# Optional: Secret to protect Vercel Cron trigger endpoint
CRON_SECRET=

# Base application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
